# Supabase Local Development Environment Variables
# These are typically managed by the Supabase CLI for local development.
# For deployed environments, set these in your hosting provider's settings.

SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="your-local-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-local-service-role-key"

# Example for a specific function if it needs its own env vars
# MY_FUNCTION_API_KEY="your_function_specific_api_key"

# Database connection string (if needed directly, though Supabase client libs handle this)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# JWT Secret (ensure this is strong and matches the one in Supabase settings)
SUPABASE_JWT_SECRET="your-super-secret-jwt-token-with-at-least-32-characters-long"
