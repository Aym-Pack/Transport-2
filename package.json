{
  "name": "samatransport-ecosystem",
  "private": true,
  "version": "0.0.1",
  "description": "Monorepo for the SAMATRANSPORT ecosystem",
  "scripts": {
    "dev": "pnpm --filter './apps/*' dev",
    "build": "pnpm --filter './apps/*' build",
    "lint": "pnpm --filter './packages/*' lint && pnpm --filter './apps/*' lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@8.6.0"
}
