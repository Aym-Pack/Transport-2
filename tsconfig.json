{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "composite": true, 
    "declaration": true, 
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@samatransport/ui/*": ["packages/ui/src/*"],
      "@samatransport/lib-core/*": ["packages/lib-core/src/*"]
    }
  },
  "exclude": ["node_modules", "**/dist", "apps", "packages"] 
}
